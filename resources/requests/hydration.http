# GET /{{connector}}/amm/positions-owned - Stableswap Pool
GET {{httpProtocol}}://{{host}}:{{port}}/connectors/{{connector}}/amm/positions-owned?network={{network}}&walletAddress={{$processEnv %walletPublicKey}}&poolAddress={{poolAddressStableswap}}
Content-Type: application/json

###

# GET /{{connector}}/amm/positions-owned - Omnipool with token
GET {{httpProtocol}}://{{host}}:{{port}}/connectors/{{connector}}/amm/positions-owned?network={{network}}&walletAddress={{$processEnv %walletPublicKey}}&omnipoolToken={{omnipoolTokenSymbol}}&omnipoolTokenAddress={{omnipoolTokenAddress}}
Content-Type: application/json

###

# GET /{{connector}}/amm/get-tradeable-tokens
GET {{httpProtocol}}://{{host}}:{{port}}/connectors/{{connector}}/amm/get-tradeable-tokens
Content-Type: application/json

###

# GET /{{connector}}/amm/get-all-tokens
GET {{httpProtocol}}://{{host}}:{{port}}/connectors/{{connector}}/amm/get-all-tokens
Content-Type: application/json

###
# Get All Positions (XYK + Stableswap) (Slow since it goes pool by pool)
# Get all positions across all supported pool types for a wallet
GET {{httpProtocol}}://{{host}}:{{port}}/connectors/{{connector}}/amm/get-all-positions?network={{network}}&walletAddress={{$processEnv %walletPublicKey}}

