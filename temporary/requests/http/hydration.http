# ===================== ROOT ROUTE =====================
#OK
# GET /
GET {{httpProtocol}}://{{host}}:{{port}}
Content-Type: application/json

###

# ===================== CONFIG ROUTES =====================

#OK
# GET /config
GET {{httpProtocol}}://{{host}}:{{port}}/config
Content-Type: application/json

###

# GET /config?chainOrConnector={{chain}}
GET {{httpProtocol}}://{{host}}:{{port}}/config?chainOrConnector={{chain}}
Content-Type: application/json

###
#OK
# GET /config?chainOrConnector={{connector}}
GET {{httpProtocol}}://{{host}}:{{port}}/config?chainOrConnector={{connector}}
Content-Type: application/json

###

# POST /config/update
POST {{httpProtocol}}://{{host}}:{{port}}/config/update
Content-Type: application/json

{
  "configPath": "{{configPath}}",
  "configValue": "{{$randomInt 2 5}}/100"
}

###
#OK
# GET /config?chainOrConnector={{connector}}
GET {{httpProtocol}}://{{host}}:{{port}}/config?chainOrConnector={{connector}}
Content-Type: application/json

###

# ===================== CONNECTOR ROUTES =====================
#OK
# GET /connectors
GET {{httpProtocol}}://{{host}}:{{port}}/connectors
Content-Type: application/json

###

# ===================== WALLET ROUTES =====================
#OK
# GET /wallet
GET {{httpProtocol}}://{{host}}:{{port}}/wallet
Content-Type: application/json

###
#OK
# DELETE /wallet/remove
DELETE {{httpProtocol}}://{{host}}:{{port}}/wallet/remove
Content-Type: application/json

{
  "chain": "{{chain}}",
  "address": "{{$processEnv %walletPublicKey}}"
}

###

#OK
# GET /wallet
GET {{httpProtocol}}://{{host}}:{{port}}/wallet
Content-Type: application/json

###
#OK
# POST /wallet/add
POST {{httpProtocol}}://{{host}}:{{port}}/wallet/add
Content-Type: application/json

{
  "chain": "{{chain}}",
  "network": "{{network}}",
  "privateKey": "{{walletMnemonic}}"
}

###
#OK
# GET /wallet
GET {{httpProtocol}}://{{host}}:{{port}}/wallet
Content-Type: application/json

###

# ===================== CHAIN ROUTES =====================
#OK
# GET /<chain>/status
GET {{httpProtocol}}://{{host}}:{{port}}/chains/{{chain}}/status?network={{network}}
Content-Type: application/json

###
#OK
# POST /<chain>/estimate-gas
POST {{httpProtocol}}://{{host}}:{{port}}/chains/{{chain}}/estimate-gas
Content-Type: application/json

{
  "chain": "{{chain}}",
  "network": "{{network}}",
  "gasLimit": "{{gasLimit}}"
}

###

# ===================== TRANSACTION ROUTES =====================
#OK
# POST /{{chain}}/poll - Poll for transaction status
POST {{httpProtocol}}://{{host}}:{{port}}/chains/{{chain}}/poll
Content-Type: application/json

{
  "network": "{{network}}",
  "txHash": "{{txHash}}"
}

###

# ===================== TOKEN ROUTES =====================
#OK
# GET /<chain>/tokens - Just network
GET {{httpProtocol}}://{{host}}:{{port}}/chains/{{chain}}/tokens?network={{network}}
Content-Type: application/json

###
#OK
# GET /<chain>/tokens - Single token
GET {{httpProtocol}}://{{host}}:{{port}}/chains/{{chain}}/tokens?network={{network}}&tokenSymbols={{nativeTokenSymbol}}
Content-Type: application/json

###
#OK
# GET /<chain>/tokens - Multiple tokens
GET {{httpProtocol}}://{{host}}:{{port}}/chains/{{chain}}/tokens?network={{network}}&tokenSymbols={{nativeTokenSymbol}},{{baseTokenSymbol}},{{quoteTokenSymbol}}
Content-Type: application/json

###

# ===================== BALANCE ROUTES =====================
#OK
# POST /{{chain}}/balances - All balances
POST {{httpProtocol}}://{{host}}:{{port}}/chains/{{chain}}/balances
Content-Type: application/json

{
  "network": "{{network}}",
  "address": "{{walletPublicKey}}"
}

###

#OK
# POST /{{chain}}/balances - Single token (string format)
POST {{httpProtocol}}://{{host}}:{{port}}/chains/{{chain}}/balances
Content-Type: application/json

{
  "network": "{{network}}",
  "address": "{{walletPublicKey}}",
  "tokens": "{{nativeTokenSymbol}}"
}

###
#OK
# POST /{{chain}}/balances - Single token (array format)
POST {{httpProtocol}}://{{host}}:{{port}}/chains/{{chain}}/balances
Content-Type: application/json

{
  "network": "{{network}}",
  "address": "{{walletPublicKey}}",
  "tokens": ["{{quoteTokenSymbol}}"]
}

###
#OK
# POST /{{chain}}/balances - Multiple tokens
POST {{httpProtocol}}://{{host}}:{{port}}/chains/{{chain}}/balances
Content-Type: application/json

{
  "network": "{{network}}",
  "address": "{{walletPublicKey}}",
  "tokens": ["{{nativeTokenSymbol}}", "{{baseTokenSymbol}}", "{{quoteTokenSymbol}}"]
}

###

# ===================== AMM CONNECTOR ROUTES =====================

# ===================== LIST POOLS =====================
#OK
# GET /hydration/amm/list-pools - List all pools
GET {{httpProtocol}}://{{host}}:{{port}}/connectors/hydration/amm/list-pools?network={{network}}
Content-Type: application/json

###
#OK
# GET /hydration/amm/list-pools - Filter by tokenSymbols
GET {{httpProtocol}}://{{host}}:{{port}}/connectors/hydration/amm/list-pools?network={{network}}&tokenSymbols=WUD&tokenSymbols=DOT
Content-Type: application/json

###
#OK
# GET /hydration/amm/list-pools - Filter by tokenAddresses (using Polkadot asset IDs)
GET {{httpProtocol}}://{{host}}:{{port}}/connectors/hydration/amm/list-pools?network={{network}}&tokenAddresses=10&tokenAddresses=22
Content-Type: application/json

###
#OK
# GET /hydration/amm/list-pools - Filter by both tokenSymbols and tokenAddresses
GET {{httpProtocol}}://{{host}}:{{port}}/connectors/hydration/amm/list-pools?network={{network}}&tokenSymbols=WUD&tokenAddresses=5
Content-Type: application/json

###
#OK
# GET /hydration/amm/list-pools - Filter stableswap pools
GET {{httpProtocol}}://{{host}}:{{port}}/connectors/hydration/amm/list-pools?network={{network}}&types=stableswap
Content-Type: application/json

###
#OK
# GET /hydration/amm/list-pools - Filter xyk pools
GET {{httpProtocol}}://{{host}}:{{port}}/connectors/hydration/amm/list-pools?network={{network}}&types=xyk
Content-Type: application/json

###

